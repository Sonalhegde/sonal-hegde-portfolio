# Server-side only. Never expose this value through NEXT_PUBLIC_* variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Optional. Base URL of a server deployment exposing /api/visitors (e.g. a
# Cloudflare Worker). Leave empty to use same-origin API routes. The static
# GitHub Pages build has no API, so visitor stats show an explicit
# "unavailable" state there — numbers are never faked.
NEXT_PUBLIC_VISITORS_API_URL=
